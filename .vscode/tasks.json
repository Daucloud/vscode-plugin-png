// Build and watch tasks for the extension and its webview.
{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "compile",
			"problemMatcher": "$esbuild",
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"type": "npm",
			"script": "watch",
			"problemMatcher": [],
			"isBackground": true,
			"presentation": {
				"reveal": "never"
			}
		}
	]
}
