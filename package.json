{
  "name": "dark-theme-image-view",
  "displayName": "Dark Theme Image View",
  "description": "A focused PNG and SVG viewer with scrolling, zoom, background controls, and clipboard support",
  "version": "1.1.0",
  "license": "MIT",
  "keywords": [
    "image",
    "dark theme",
    "transparent background",
    "image view",
    "png",
    "svg",
    "clipboard",
    "image preview"
  ],
  "publisher": "Daucloud",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/daucloud/vscode-plugin-png"
  },
  "homepage": "https://github.com/Daucloud/vscode-plugin-png#readme",
  "bugs": {
    "url": "https://github.com/Daucloud/vscode-plugin-png/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCustomEditor:darkThemeImageViewEditor",
    "onCommand:darkThemeImageView.copyImage",
    "onCommand:darkThemeImageView.toggleBackground",
    "onCommand:darkThemeImageView.zoomIn",
    "onCommand:darkThemeImageView.zoomOut",
    "onCommand:darkThemeImageView.fitWidth",
    "onCommand:darkThemeImageView.actualSize"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "darkThemeImageViewEditor",
        "displayName": "Dark Theme Image View Editor",
        "selector": [
          {
            "filenamePattern": "*.{png,PNG,svg,SVG}"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "darkThemeImageView.copyImage",
        "title": "Copy Image",
        "category": "Dark Theme Image View",
        "icon": "$(copy)"
      },
      {
        "command": "darkThemeImageView.toggleBackground",
        "title": "Toggle Background",
        "category": "Dark Theme Image View",
        "icon": "$(color-mode)"
      },
      {
        "command": "darkThemeImageView.zoomIn",
        "title": "Zoom In",
        "category": "Dark Theme Image View"
      },
      {
        "command": "darkThemeImageView.zoomOut",
        "title": "Zoom Out",
        "category": "Dark Theme Image View"
      },
      {
        "command": "darkThemeImageView.fitWidth",
        "title": "Fit Image to Width",
        "category": "Dark Theme Image View"
      },
      {
        "command": "darkThemeImageView.actualSize",
        "title": "Show Image at Actual Size",
        "category": "Dark Theme Image View"
      }
    ],
    "keybindings": [
      {
        "command": "darkThemeImageView.copyImage",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "activeCustomEditorId == darkThemeImageViewEditor"
      },
      {
        "command": "darkThemeImageView.toggleBackground",
        "key": "b",
        "when": "activeCustomEditorId == darkThemeImageViewEditor"
      },
      {
        "command": "darkThemeImageView.zoomIn",
        "key": "ctrl+=",
        "mac": "cmd+=",
        "when": "activeCustomEditorId == darkThemeImageViewEditor"
      },
      {
        "command": "darkThemeImageView.zoomOut",
        "key": "ctrl+-",
        "mac": "cmd+-",
        "when": "activeCustomEditorId == darkThemeImageViewEditor"
      },
      {
        "command": "darkThemeImageView.fitWidth",
        "key": "ctrl+0",
        "mac": "cmd+0",
        "when": "activeCustomEditorId == darkThemeImageViewEditor"
      },
      {
        "command": "darkThemeImageView.actualSize",
        "key": "ctrl+1",
        "mac": "cmd+1",
        "when": "activeCustomEditorId == darkThemeImageViewEditor"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "darkThemeImageView.copyImage",
          "when": "activeCustomEditorId == darkThemeImageViewEditor",
          "group": "navigation@1"
        },
        {
          "command": "darkThemeImageView.toggleBackground",
          "when": "activeCustomEditorId == darkThemeImageViewEditor",
          "group": "navigation@2"
        }
      ],
      "webview/context": [
        {
          "command": "darkThemeImageView.copyImage",
          "when": "webviewId == darkThemeImageViewEditor",
          "group": "1_modification@1"
        },
        {
          "command": "darkThemeImageView.toggleBackground",
          "when": "webviewId == darkThemeImageViewEditor",
          "group": "1_modification@2"
        }
      ]
    },
    "configuration": {
      "title": "Dark Theme Image View",
      "properties": {
        "darkThemeImageView.defaultBackground": {
          "type": "string",
          "enum": [
            "auto",
            "white",
            "checkerboard",
            "editor"
          ],
          "enumDescriptions": [
            "Use white in dark themes and a checkerboard in light themes.",
            "Always place images on a white background.",
            "Always show transparency on a checkerboard.",
            "Use the current editor background color."
          ],
          "default": "auto",
          "description": "Controls the initial background used for transparent images. Press B in the image viewer to cycle backgrounds temporarily."
        },
        "darkThemeImageView.defaultZoom": {
          "type": "string",
          "enum": [
            "fitWidth",
            "fit",
            "actualSize"
          ],
          "enumDescriptions": [
            "Fit wide images to the viewport while keeping tall images scrollable.",
            "Fit the entire image inside the viewport.",
            "Show one image pixel per CSS pixel."
          ],
          "default": "fitWidth",
          "description": "Controls the zoom level used when an image is first opened."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run typecheck && node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "package": "npm run check && node scripts/build.mjs --production",
    "check": "npm run typecheck && npm run lint && npm test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node scripts/test.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "esbuild": "^0.25.12",
    "eslint": "^10.8.0",
    "typescript": "^5.9.3"
  }
}
